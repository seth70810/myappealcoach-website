# Netlify redirect rules. Plain text, no build step — Netlify reads this file
# from the publish root on every deploy.
#
# Format:  <from-path>  <to-path>  <status>
# 301 = permanent, which is what you want for retired URLs: search engines
# transfer ranking to the new page instead of treating it as a fresh one.

# --- Wix page slugs -----------------------------------------------------
# Wix named untitled pages /blank, /blank-1, and so on. Anyone with an old
# link or a search result pointing at these lands on the right page instead
# of a 404.
/blank      /appellate-navigator.html    301
/blank-1    /appellate-navigator.html    301

# --- friendlier paths ---------------------------------------------------
# Extensionless URLs for the pages most likely to be typed or spoken aloud.
/fantasy-moot    /fantasy-moot.html      301
/contact         /contact.html           301
/faq             /faq.html               301
/rules           /local-rules.html       301
/recordings      /recordings.html        301
/navigator       /appellate-navigator.html   301

# --- retired pages ------------------------------------------------------
# "Tips for Briefs" and "Tips for Argument" merged into the Appellate Navigator.
/write-your-brief.html   /appellate-navigator.html   301
/oral-argument.html      /appellate-navigator.html   301

# --- Appellate Navigator ("Procedure") — now served by the Flask app --------
# The tool moved into the app so its entry-gate email is captured into the admin.
# The trailing "!" FORCES the redirect even though a legacy procedure.html still
# sits in this repo (without "!", Netlify would serve the static file instead).
# IMPORTANT: deploy the app first (so app.myappealcoach.com/procedure works),
# THEN deploy this — otherwise /procedure briefly redirects to a 404.
/procedure       https://app.myappealcoach.com/procedure   301!
/procedure.html  https://app.myappealcoach.com/procedure   301!

# --- Texas Appellate Navigator — served by the Flask app --------------------
# Same pattern as Procedure: app-served so the entry-gate name/email are captured.
# Forced ("!") so it overrides the static Texas.html copy that also lives in this repo.
/texas       https://app.myappealcoach.com/texas   301!
/Texas.html  https://app.myappealcoach.com/texas   301!
/texas.html  https://app.myappealcoach.com/texas   301!

# Anything unmatched falls through to 404.html automatically — Netlify picks
# that up by filename, so it needs no rule here.
